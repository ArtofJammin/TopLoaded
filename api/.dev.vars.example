# Copy to api/.dev.vars for the local dev server (tools/dev-server.mjs) or
# `wrangler dev`. Never commit the real file. Everything is optional.

# Passcodes for the local dev server only (production uses the *_PIN_HASH secrets)
DEV_STAFF_PIN=staff
DEV_ADMIN_PIN=admin

# Production-style secrets (sha256 hex of each passcode; generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('your passcode').digest('hex'))"
# STAFF_PIN_HASH=
# ADMIN_PIN_HASH=
# TOKEN_SECRET=some-long-random-string

# Square (Developer Dashboard → your app). Sandbox first.
# SQUARE_ENV=sandbox
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://your-worker.workers.dev/square/webhook
# CLAIM_CHECKOUT_ENABLED=false
# SHOP_CHECKOUT_ENABLED=false
# SHIPPING_CENTS=499
# FREE_SHIPPING_CENTS=10000

# Email notifications for form submissions (resend.com)
# RESEND_API_KEY=
# NOTIFY_EMAIL=toploadedtcg@gmail.com
# EMAIL_FROM=Top Loaded Website <site@yourdomain.com>

# "Sync now" button → runs the inventory GitHub Action (token needs repo "actions: write")
# GITHUB_TOKEN=
# GITHUB_REPO=ArtofJammin/TopLoaded

# Optional read-only public TCGplayer listing checks (no partner API key).
# Local Node server keeps these off unless explicitly enabled. See INVENTORY-SYNC.md.
# LISTING_CHECKS_ENABLED=true
# INVENTORY_ALERT_EMAIL_ENABLED=false
# TCG_NOTIFICATION_ENABLED=false
# TCG_NOTIFICATION_SECRET=

# Automatic five-star Google reviews (requires a real Place ID in Admin and Places billing)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_REVIEWS_TERMS_URL=https://your-public-site/terms
# GOOGLE_REVIEWS_PRIVACY_URL=https://your-public-site/privacy

# Optional: raises pokemontcg.io rate limits for the card-worth lookup
# POKEMONTCG_API_KEY=
